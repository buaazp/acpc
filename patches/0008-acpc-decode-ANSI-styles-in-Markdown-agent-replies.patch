@@ -0,0 +1,100 @@
+//! Decode agent-supplied ANSI styling before measuring or wrapping Markdown spans.
+//!
+//! Keep the style across Markdown events (e.g. a bold translation), while leaving
+//! Markdown's own styles in place when an ANSI attribute is reset. Never pass
+//! terminal control sequences through to the transcript.
+
+use codex_ansi_escape::ansi_escape_line;
+use itertools::Either;
+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::style::Style;
+use ratatui::text::Span;
+
+#[derive(Default)]
+pub(super) struct AnsiText {
+    style: Style,
+}
+
+impl AnsiText {
+    pub(super) fn spans(
+        &mut self,
+        span: Span<'static>,
+    ) -> impl Iterator<Item = Span<'static>> + use<> {
+        if !crate::acpc::enabled() {
+            return Either::Left(std::iter::once(span));
+        }
+        if !span.content.contains('\x1b') {
+            let style = span.style.patch(self.style);
+            return Either::Left(std::iter::once(span.style(style)));
+        }
+        let mut spans = Vec::new();
+        let mut remaining = span.content.as_ref();
+        while let Some(start) = remaining.find('\x1b') {
+            if start > 0 {
+                spans.push(Span::styled(
+                    remaining[..start].to_owned(),
+                    span.style.patch(self.style),
+                ));
+            }
+            remaining = &remaining[start..];
+            let end = escape_end(remaining);
+            let sequence = &remaining[..end];
+            if sequence.starts_with("\x1b[") && sequence.ends_with('m') {
+                // Reuse the existing SGR decoder for palette, indexed and RGB
+                // colors and modifiers. The sentinel exposes trailing resets.
+                let decoded = ansi_escape_line(&format!("{sequence}x"));
+                if let Some(last) = decoded.spans.last() {
+                    self.style = self.style.patch(last.style);
+                    if self.style.fg == Some(Color::Reset) {
+                        self.style.fg = None;
+                    }
+                    if self.style.bg == Some(Color::Reset) {
+                        self.style.bg = None;
+                    }
+                    if self.style.underline_color == Some(Color::Reset) {
+                        self.style.underline_color = None;
+                    }
+                    self.style.sub_modifier = Modifier::empty();
+                }
+            }
+            remaining = &remaining[end..];
+        }
+        if !remaining.is_empty() {
+            spans.push(Span::styled(
+                remaining.to_owned(),
+                span.style.patch(self.style),
+            ));
+        }
+        Either::Right(spans.into_iter())
+    }
+}
+
+/// Consume a whole escape, including incomplete streaming suffixes. OSC/DCS
+/// strings end at BEL or ST; their payload must not become visible text.
+fn escape_end(input: &str) -> usize {
+    let bytes = input.as_bytes();
+    match bytes.get(1) {
+        Some(b'[') => bytes
+            .iter()
+            .enumerate()
+            .skip(2)
+            .find(|(_, byte)| (0x40..=0x7e).contains(*byte))
+            .map_or(input.len(), |(end, _)| end + 1),
+        Some(b']' | b'P' | b'X' | b'^' | b'_') => {
+            for index in 2..bytes.len() {
+                if bytes[index] == b'\x07' {
+                    return index + 1;
+                }
+                if bytes[index] == b'\x1b' && bytes.get(index + 1) == Some(&b'\\') {
+                    return index + 2;
+                }
+            }
+            input.len()
+        }
+        _ => input
+            .char_indices()
+            .nth(2)
+            .map_or(input.len(), |(end, _)| end),
+    }
+}
