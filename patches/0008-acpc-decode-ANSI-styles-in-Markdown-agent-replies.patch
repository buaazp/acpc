+//! ACP agents can mix plugin-supplied ANSI styles with Markdown source.
+
+use super::ListSpacing;
+use super::render_markdown_text_with_width;
+use super::render_streaming_markdown_lines_with_width_and_cwd;
+use pretty_assertions::assert_eq;
+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::text::Text;
+
+#[test]
+fn bbilingual_translation_keeps_gray_without_escape_text() {
+    let _acpc = crate::acpc::enable_for_test();
+    let rendered = render_markdown_text_with_width(
+        "Hello world.\n\x1b[90m你好，世界。\x1b[39m\nEnglish again.",
+        Some(80),
+    );
+
+    assert_eq!(
+        rendered.to_string(),
+        "Hello world.\n你好，世界。\nEnglish again."
+    );
+    let translation = rendered.lines[1]
+        .spans
+        .iter()
+        .find(|span| span.content.contains("你好"));
+    assert_eq!(
+        translation.map(|span| span.style.fg),
+        Some(Some(Color::DarkGray))
+    );
+    assert!(
+        rendered.lines[2]
+            .spans
+            .iter()
+            .all(|span| span.style.fg != Some(Color::DarkGray))
+    );
+}
+
+#[test]
+fn ansi_styles_compose_with_markdown_and_reset_after_it() {
+    let _acpc = crate::acpc::enable_for_test();
+    let rendered = render_markdown_text_with_width(
+        "\x1b[90m翻译 **粗体** 与 `code`。\x1b[0m\nEnglish.",
+        Some(80),
+    );
+
+    assert_eq!(rendered.to_string(), "翻译 粗体 与 code。\nEnglish.");
+    let bold = rendered.lines[0]
+        .spans
+        .iter()
+        .find(|span| span.content.contains("粗体"));
+    assert!(bold.is_some_and(|span| span.style.add_modifier.contains(Modifier::BOLD)));
+    assert_eq!(bold.map(|span| span.style.fg), Some(Some(Color::DarkGray)));
+    assert!(
+        rendered.lines[1]
+            .spans
+            .iter()
+            .all(|span| span.style.fg != Some(Color::DarkGray))
+    );
+}
+
+#[test]
+fn styled_cjk_wraps_like_the_same_unstyled_text() {
+    let _acpc = crate::acpc::enable_for_test();
+    let plain = "- Fast\n  快速响应并保持中英文排版一致。\n- Safe\n  安全可靠。";
+    let styled = "- Fast\n  \x1b[90m快速响应并保持中英文排版一致。\x1b[39m\n- Safe\n  \x1b[90m安全可靠。\x1b[39m";
+
+    for width in [12, 20, 40] {
+        assert_eq!(
+            render_markdown_text_with_width(styled, Some(width)).to_string(),
+            render_markdown_text_with_width(plain, Some(width)).to_string(),
+            "ANSI sequences must not consume display columns at width {width}",
+        );
+    }
+}
+
+#[test]
+fn styled_table_cells_use_visible_widths() {
+    let _acpc = crate::acpc::enable_for_test();
+    let plain = "| Name | Value |\n| --- | --- |\n| 状态 | Ready |\n| 结果 | 成功 |";
+    let styled = "| Name | Value |\n| --- | --- |\n| \x1b[90m状态\x1b[39m | Ready |\n| 结果 | \x1b[32m成功\x1b[0m |";
+
+    for width in [20, 60] {
+        assert_eq!(
+            render_markdown_text_with_width(styled, Some(width)).to_string(),
+            render_markdown_text_with_width(plain, Some(width)).to_string(),
+            "ANSI sequences must not alter table layout at width {width}",
+        );
+    }
+}
+
+#[test]
+fn streaming_partial_sgr_never_draws_escape_fragments() {
+    let _acpc = crate::acpc::enable_for_test();
+    let source = "Hello\n\x1b[90m你好\x1b[39m";
+    for end in source
+        .char_indices()
+        .map(|(index, _)| index)
+        .chain([source.len()])
+    {
+        let rendered = render_streaming_markdown_lines_with_width_and_cwd(
+            &source[..end],
+            Some(20),
+            None,
+            &|_| false,
+            ListSpacing::AfterMultiline,
+        );
+        let visible =
+            Text::from(crate::terminal_hyperlinks::visible_lines(rendered.lines)).to_string();
+        assert!(
+            !visible.contains('\x1b'),
+            "raw ESC at source boundary {end}: {visible:?}"
+        );
+        assert!(
+            !visible.contains('['),
+            "partial SGR at source boundary {end}: {visible:?}"
+        );
+    }
+}
+
+#[test]
+fn indexed_and_rgb_colors_survive_markdown_rendering() {
+    let _acpc = crate::acpc::enable_for_test();
+    let rendered = render_markdown_text_with_width(
+        "\x1b[38;5;123mIndexed\x1b[39m and \x1b[38;2;12;34;56mRGB\x1b[0m.",
+        Some(80),
+    );
+
+    assert_eq!(rendered.to_string(), "Indexed and RGB.");
+    for (label, color) in [
+        ("Indexed", Color::Indexed(123)),
+        ("RGB", Color::Rgb(12, 34, 56)),
+    ] {
+        let span = rendered.lines[0]
+            .spans
+            .iter()
+            .find(|span| span.content.contains(label));
+        assert_eq!(span.map(|span| span.style.fg), Some(Some(color)));
+    }
+}
+
+#[test]
+fn ansi_reset_inside_markdown_bold_preserves_markdown_bold() {
+    let _acpc = crate::acpc::enable_for_test();
+    let rendered = render_markdown_text_with_width("**\x1b[1;90mBefore \x1b[0mAfter**", Some(80));
+
+    assert_eq!(rendered.to_string(), "Before After");
+    let after = rendered.lines[0]
+        .spans
+        .iter()
+        .find(|span| span.content.contains("After"));
+    assert!(after.is_some_and(|span| span.style.add_modifier.contains(Modifier::BOLD)));
+    assert!(after.is_some_and(|span| span.style.fg != Some(Color::DarkGray)));
+}
+
+#[test]
+fn non_sgr_controls_are_discarded_instead_of_rendered() {
+    let _acpc = crate::acpc::enable_for_test();
+    let rendered = render_markdown_text_with_width(
+        "\x1b[2JStart \x1b]0;private-title\x07middle \x1b]8;;https://example.com\x1b\\label\x1b]8;;\x1b\\ end.",
+        Some(80),
+    );
+
+    assert_eq!(rendered.to_string(), "Start middle label end.");
+}
+
+#[test]
+fn ansi_looking_plain_text_without_escape_stays_literal() {
+    let _acpc = crate::acpc::enable_for_test();
+    let rendered = render_markdown_text_with_width("[90m你好[39m", Some(80));
+
+    assert_eq!(rendered.to_string(), "[90m你好[39m");
+}
